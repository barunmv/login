# Server-only Supabase credentials. Never use NEXT_PUBLIC_ for the service role key.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use a cryptographically random value with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION=7d
